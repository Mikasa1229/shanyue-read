# Never commit real keys. Copy to .env or set these in your process environment.
DEEPSEEK_API_KEY=
# A long, random value used to encrypt users' BYOK keys at rest. Changing it makes old keys unreadable.
AGENT_ENCRYPTION_KEY=
# Required only for direct /internal/agent/** operations; never expose this value to browsers.
AGENT_INTERNAL_TOKEN=
# Shared only between reader-gateway and reader-agent. Required whenever Agent HTTP APIs are exposed.
AGENT_GATEWAY_TOKEN=
AGENT_PLATFORM_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional comma-separated HTTPS hosts for reviewed self-hosted OpenAI-compatible BYOK endpoints.
# Official DeepSeek and OpenAI endpoints do not need to be listed.
AGENT_BYOK_ALLOWED_HOSTS=
MILVUS_HOST=localhost
MILVUS_PORT=19530
AGENT_MILVUS_ENABLED=true
# `hash` is the no-key development fallback. Set `openai-compatible` and provide a
# reviewed endpoint/key for a real semantic model. Keep collection names/versioned
# dimensions aligned when changing providers so an old vector collection is never reused.
AGENT_EMBEDDING_PROVIDER=hash
AGENT_EMBEDDING_BASE_URL=
AGENT_EMBEDDING_PATH=/v1/embeddings
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_MODEL=text-embedding-3-small
AGENT_EMBEDDING_DIMENSIONS=256
AGENT_EMBEDDING_OPERATION_TIMEOUT_MILLIS=3000
AGENT_EMBEDDING_FAILURE_COOLDOWN_SECONDS=30
MILVUS_COLLECTION=reader_agent_chunks_256
MILVUS_BOOK_PROFILE_COLLECTION=book_profile_vectors_256
MILVUS_CHARACTER_COLLECTION=character_vectors_256
MILVUS_EVENT_COLLECTION=event_vectors_256
MILVUS_COMMUNITY_PROFILE_COLLECTION=lightrag_community_vectors_256
MILVUS_USER_PREFERENCE_COLLECTION=user_preference_vectors_256
ELASTICSEARCH_URL=http://localhost:9200
AGENT_ELASTICSEARCH_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=reader-agent-dev
AGENT_NEO4J_ENABLED=true
# Optional: uses the platform model during indexing for structured graph extraction.
AGENT_GRAPH_LLM_ENABLED=false
# Bump this after changing the embedding provider/implementation; unchanged profiles will be re-projected on refresh.
AGENT_EMBEDDING_MODEL_VERSION=hash-embedding-v1
AGENT_MIN_GRAPH_CONFIDENCE=0.60
# Optional OpenAI-compatible Reranker enhancement for bounded LightRAG evidence candidates.
# The dependency-free local hybrid reranker is the core/default path; keep these empty to use it.
AGENT_RERANKER_ENABLED=false
AGENT_RERANKER_BASE_URL=
AGENT_RERANKER_PATH=/v1/rerank
AGENT_RERANKER_API_KEY=
AGENT_RERANKER_MODEL=rerank-v3.5
AGENT_RERANKER_OPERATION_TIMEOUT_MILLIS=3000
AGENT_RERANKER_FAILURE_COOLDOWN_SECONDS=30
